{
  "_comment": "Portal 2 texture -> your MaterialService variant. Rules are checked top to bottom; the first whose 'match' (a regular expression, lower case, against the texture path like 'metal/black_wall_metal_002c') fits wins. variant = the MaterialVariant name in MaterialService (\"\" = none). base = the Roblox Material the part starts with (the map's FixMaterials script switches it to the variant's own BaseMaterial in game). portalable = false adds the NoPortal attribute (your portal gun refuses those). special: skip (not built), invisible (an invisible wall), skipface (that side isn't drawn).",
  "rules": [
    { "match": "^tools/toolsnodraw",         "special": "skipface" },
    { "match": "^tools/toolsskybox",         "special": "skip" },
    { "match": "^tools/toolstrigger",        "special": "skip" },
    { "match": "^tools/toolshint|^tools/toolsskip|^tools/toolsblocklight|^tools/toolsoccluder|^tools/toolsareaportal|^tools/toolsfog|^tools/toolsblockbullets|^tools/toolsblock_los", "special": "skip" },
    { "match": "^tools/toolsclip|^tools/toolsplayerclip|^tools/toolsinvisible|^tools/toolsnpcclip", "special": "invisible" },
    { "match": "^tools/toolsblack",          "variant": "",                  "base": "SmoothPlastic", "portalable": false, "color": [0, 0, 0] },

    { "match": "white_floor",                "variant": "White F 2.25",      "base": "SmoothPlastic", "portalable": true },
    { "match": "white_ceiling",              "variant": "White 4.5 Ceiling", "base": "SmoothPlastic", "portalable": true },
    { "match": "white_wall_tile003f|white_wall_tile_9|white.*large", "variant": "White 9", "base": "SmoothPlastic", "portalable": true },
    { "match": "white_wall_tile|white_wall|tile/white", "variant": "White 4.5", "base": "SmoothPlastic", "portalable": true },
    { "match": "white_checker|checker.*white", "variant": "White Checker",   "base": "SmoothPlastic", "portalable": true },

    { "match": "black_floor_metal|metal_floor", "variant": "Metal Floor 4.5", "base": "Metal", "portalable": false },
    { "match": "black_ceiling_metal",        "variant": "Metal 4.5",         "base": "Metal", "portalable": false },
    { "match": "black_wall_metal_002e|black_wall_metal.*large", "variant": "Metal 9", "base": "Metal", "portalable": false },
    { "match": "black_wall_metal|metal/black", "variant": "Metal 4.5",       "base": "Metal", "portalable": false },
    { "match": "metal_tile",                 "variant": "Metal Tile",        "base": "Metal", "portalable": false },
    { "match": "metal_panel|metalpanel",     "variant": "Metal Panel",       "base": "Metal", "portalable": false },
    { "match": "diamond",                    "variant": "DiamondFloor",      "base": "DiamondPlate", "portalable": false },
    { "match": "corrugated",                 "variant": "Corrugated",        "base": "Metal", "portalable": false },
    { "match": "rust|corrosion|corroded",    "variant": "Rusted Metal",      "base": "CorrodedMetal", "portalable": false },
    { "match": "catwalk|grate|mesh",         "variant": "Catwalk",           "base": "Metal", "portalable": false },
    { "match": "^metal/",                    "variant": "Metal Scratch",     "base": "Metal", "portalable": false },

    { "match": "observation|obs_wall|observ", "variant": "Observe Wall",     "base": "SmoothPlastic", "portalable": false },
    { "match": "elevator",                   "variant": "Elevator Screen",   "base": "SmoothPlastic", "portalable": false },
    { "match": "glasswindow|glass_window",   "variant": "Glass Window",      "base": "Glass", "portalable": false, "transparency": 0.6 },
    { "match": "^glass/|glass",              "variant": "Glass Normal",      "base": "Glass", "portalable": false, "transparency": 0.5 },
    { "match": "toxic|slime|goo",            "variant": "Toxic Goo",         "base": "SmoothPlastic", "portalable": false, "collide": false },

    { "match": "dev_measuregeneric|dev/graygrid|dev_measurewall01c", "variant": "DevG", "base": "SmoothPlastic", "portalable": true },
    { "match": "dev.*orange|dev_measurewall01b", "variant": "DevO",          "base": "SmoothPlastic", "portalable": true },
    { "match": "^dev/",                      "variant": "DevW",              "base": "SmoothPlastic", "portalable": true },

    { "match": "concrete_modular|bts.*concrete|concrete/concrete_modular", "variant": "bts1concrete", "base": "Concrete", "portalable": true },
    { "match": "cinder",                     "variant": "Cinderblocks",      "base": "Concrete", "portalable": true },
    { "match": "concrete",                   "variant": "Worn Concrete",     "base": "Concrete", "portalable": true },
    { "match": "brick",                      "variant": "Brick",             "base": "Brick", "portalable": false },
    { "match": "plaster",                    "variant": "Plaster",           "base": "SmoothPlastic", "portalable": false },
    { "match": "stucco",                     "variant": "Stucco Beige",      "base": "SmoothPlastic", "portalable": false },
    { "match": "carpet",                     "variant": "CarpetFloor",       "base": "Fabric", "portalable": false },
    { "match": "wood.*panel|paneling",       "variant": "Wood Paneling",     "base": "Wood", "portalable": false },
    { "match": "wood.*floor",                "variant": "Wood Floor",        "base": "WoodPlanks", "portalable": false },
    { "match": "wood",                       "variant": "Wood Wall",         "base": "Wood", "portalable": false },
    { "match": "marble",                     "variant": "MarbleTile",        "base": "Marble", "portalable": false },
    { "match": "ceiling",                    "variant": "Office Ceiling",    "base": "SmoothPlastic", "portalable": false },
    { "match": "poster|signage|sign",        "variant": "Poster",            "base": "SmoothPlastic", "portalable": false },
    { "match": "^lights/|light",             "variant": "Light",             "base": "Neon", "portalable": false },
    { "match": "rock|cave|nature",           "variant": "Rockpit",           "base": "Slate", "portalable": false },
    { "match": "foil|space",                 "variant": "SpaceFoil",         "base": "Foil", "portalable": false },

    { "match": ".*",                         "variant": "",                  "base": "SmoothPlastic", "portalable": false, "color": [150, 150, 150] }
  ],
  "entities": {
    "_comment": "Portal 2 entity classname -> what goes in the map. asset = a model name in ReplicatedStorage.PortalAssets (the map's FixMaterials script swaps the placeholder for it). spawn = a spawn part (PlayerSpawn, PlayerSpawnBlue, PlayerSpawnOrange).",
    "info_player_start":          { "spawn": "PlayerSpawn" },
    "info_coop_spawn":            { "spawn": "coop" },
    "prop_testchamber_door":      { "asset": "ChamberLockDoor", "size": [5, 8, 1] },
    "prop_floor_button":          { "asset": "Button", "size": [5, 0.6, 5] },
    "prop_floor_cube_button":     { "asset": "Button", "size": [5, 0.6, 5], "attr": { "ButtonType": "Cube" } },
    "prop_floor_ball_button":     { "asset": "Button", "size": [5, 0.6, 5], "attr": { "ButtonType": "Sphere" } },
    "prop_button":                { "asset": "PedestalButton", "size": [1.5, 4, 1.5] },
    "prop_under_button":          { "asset": "PedestalButton", "size": [1.5, 4, 1.5] },
    "prop_weighted_cube":         { "asset": "Cube", "size": [3.5, 3.5, 3.5], "cube": true },
    "prop_monster_box":           { "asset": "Cube", "size": [3.5, 3.5, 3.5], "cube": true },
    "npc_portal_turret_floor":    { "asset": "Turret", "size": [2, 4, 2] },
    "prop_laser_catcher":         { "asset": "Laser Catcher", "size": [4, 4, 1] },
    "prop_laser_relay":           { "asset": "Laser Catcher", "size": [2, 4, 2] },
    "env_portal_laser":           { "asset": "Laser Emitter", "size": [3, 3, 2] },
    "prop_tractor_beam":          { "asset": "TBeam", "size": [6, 6, 2] },
    "prop_wall_projector":        { "asset": "LightBridgeFree", "size": [6, 2, 2] },
    "trigger_portal_cleanser":    { "asset": "Fizzler", "brush": true },
    "trigger_catapult":           { "asset": "FaithPlate", "brush": true },
    "trigger_hurt":               { "zone": "PortalKillZone", "brush": true },
    "prop_paint_bomb":            { "skip": true }
  }
}
